# Store text with LF line endings no matter how this PC's git is set up
# (core.autocrlf=true here would otherwise mix CRLF and LF).
* text=auto eol=lf
*.bat text eol=crlf

# Binary files: never touch their bytes.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.docx binary
*.db   binary
*.woff binary
*.woff2 binary
